# Copy to .env and replace change-me in BOTH the password and URLs before startup.
# If the password contains URL-reserved characters, percent-encode it in URLs.
POSTGRES_DB=ucl_application_review
POSTGRES_USER=ucl_app
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://ucl_app:change-me@127.0.0.1:5432/ucl_application_review
# Create this separate database explicitly; tests may destroy ONLY its contents.
TEST_DATABASE_URL=postgresql+psycopg://ucl_app:change-me@127.0.0.1:5432/ucl_application_review_test
