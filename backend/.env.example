# Copy to .env and replace change-me in BOTH the password and URLs before startup.
# If the password contains URL-reserved characters, percent-encode it in URLs.
POSTGRES_DB=ucl_application_review
POSTGRES_USER=ucl_app
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://ucl_app:change-me@127.0.0.1:5432/ucl_application_review
# Create this separate database explicitly; tests may destroy ONLY its contents.
TEST_DATABASE_URL=postgresql+psycopg://ucl_app:change-me@127.0.0.1:5432/ucl_application_review_test

# Opt-in document API. Private JSON maps SHA-256 bearer-token digests to stored user IDs.
# Leave empty to disable document routes. This is separate from the prototype browser login.
DOCUMENT_API_TOKENS_FILE=

# Server-side switch: qwen is the development target; openai is opt-in API testing.
INFERENCE_PROVIDER=qwen
# Fixed synthetic probes only; keep false except during local connection testing.
INFERENCE_PROBE_ENABLED=false

# Qwen/vLLM. Leave URL/key empty to keep this provider unconfigured.
# The Mac SSH tunnel exposes VM port 8000 at 127.0.0.1:18000.
QWEN_BASE_URL=
QWEN_MODEL=admissions-qwen
# Set exactly one key source. Prefer the mode-600 file created by qwenctl.
QWEN_API_KEY=
QWEN_API_KEY_FILE=
QWEN_TIMEOUT_SECONDS=90

# OpenAI testing uses https://api.openai.com/v1; its key is never sent to Qwen.
# Configure exactly one key source. These are ignored while qwen is selected.
OPENAI_API_KEY=
OPENAI_API_KEY_FILE=
OPENAI_MODEL=gpt-6-luna
OPENAI_TIMEOUT_SECONDS=90
